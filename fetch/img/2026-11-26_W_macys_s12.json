ource":"commons-desc-page"},"Artist":{"value":"USN","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"91639050":{"pageid":91639050,"ns":6,"title":"File:Personnel and equipment design concept for a maritime patrol airship (non-rigid) to conduct search, anti-submarine warfare, and airborne mine counter-measures missions. (IA personnelequipme00mcgi).pdf","index":6,"imagerepository":"local","imageinfo":[{"size":11008810,"width":1141,"height":1602,"pagecount":456,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/03/Personnel_and_equipment_design_concept_for_a_maritime_patrol_airship_%28non-rigid%29_to_conduct_search%2C_anti-submarine_warfare%2C_and_airborne_mine_counter-measures_missions._%28IA_personnelequipme00mcgi%29.pdf/page1-960px-thumbnail.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":2246,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/03/Personnel_and_equipment_design_concept_for_a_maritime_patrol_airship_%28non-rigid%29_to_conduct_search%2C_anti-submarine_warfare%2C_and_airborne_mine_counter-measures_missions._%28IA_personnelequipme00mcgi%29.pdf/page1-960px-thumbnail.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":2246},"url":"https://upload.wikimedia.org/wikipedia/commons/0/03/Personnel_and_equipment_design_concept_for_a_maritime_patrol_airship_%28non-rigid%29_to_conduct_search%2C_anti-submarine_warfare%2C_and_airborne_mine_counter-measures_missions._%28IA_personnelequipme00mcgi%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Personnel_and_equipment_design_concept_for_a_maritime_patrol_airship_(non-rigid)_to_conduct_search,_anti-submarine_warfare,_and_airborne_mine_counter-measures_missions._(IA_personnelequipme00mcgi).pdf","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/91639050","extmetadata":{"DateTime":{"value":"2020-06-27 20:47:09","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"<div class=\"fn\">\nPersonnel and equipment design concept for a maritime patrol airship (non-rigid) to conduct search, anti-submarine warfare, and airborne mine counter-measures missions.</div>","source":"commons-desc-page"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"PD US Government|FEDLINK - United States Federal Collection|Academic theses and dissertations of the Naval Postgraduate School|Documents from the US Naval Postgraduate School Library|Scans from the Internet Archive/unverified|CC-PD-Mark|Scans from the Internet Archive|Books uploaded by F\u00e6|Books without Wikidata item|1979 books about aviation|Books about airships","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"Artist":{"value":"<div class=\"fn value\">\nMcGinlay, Thomas Charles John</div>","source":"commons-desc-page"},"ImageDescription":{"value":"<div class=\"description\">\n<dl><dd>Thesis (M.S. in Management)--Naval Postgraduate School, Dec. 1979</dd>\n<dd>Bibliography: l. 219-222</dd>\n<dd>A personnel and equipment design concept for a non-rigid, 100 hour endurance, Maritime Patrol Airship meeting Search and Rescue (SAR), Anti- Submarine Warfare (ASW), and Airborne Mine Countermeasures (AMCM) requirements was developed. The Maritime Patrol Airship could readily be equipped with off- the-shelf equipment. Minimal new design equipment requirements were identified. A baseline flight scenario and on station scenarios for: SAR, transoceanic ASW utilizing a passive towed array sonar, and AMCM were developed. Human factors task analyses and a time line analysis were constructed from the scenarios. Manning reductions resulted for each scenario (3 crewmembers for SAR, 10 crewmembers for transoceanic ASW, 7 crewmembers for AMCM). Further research areas are identified. (Author)</dd></dl>\n<br>Subjects: Management</div>","source":"commons-desc-page"},"Credit":{"value":"<dl><dd><a href=\"//archive.org/details/personnelequipme00mcgi\" class=\"extiw\" title=\"iarchive:personnelequipme00mcgi\"><bdi class=\"description en\" lang=\"en\" dir=\"ltr\">Internet Archive identifier:</bdi> personnelequipme00mcgi</a></dd>\n<dd><a rel=\"nofollow\" class=\"external free\" href=\"https://archive.org/download/personnelequipme00mcgi/personnelequipme00mcgi.pdf\">https://archive.org/download/personnelequipme00mcgi/personnelequipme00mcgi.pdf</a></dd></dl>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"192149777":{"pageid":192149777,"ns":6,"title":"File:Report to the National Security Council by the Continental Defense Committee on Continental Defense, Part 6 of 10 - DPLA - a71b3e56f061c9bec4de10b1a0aae065.pdf","index":11,"imagerepository":"local","imageinfo":[{"size":10958106,"width":1275,"height":1650,"pagecount":41,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1d/Report_to_the_National_Security_Council_by_the_Continental_Defense_Co