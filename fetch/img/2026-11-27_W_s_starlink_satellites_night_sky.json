1":{"pageid":115179331,"ns":6,"title":"File:Light pollution, Third Place.jpg","index":3,"imagerepository":"local","imageinfo":[{"size":1686589,"width":2400,"height":3601,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/22/Light_pollution%2C_Third_Place.jpg/1920px-Light_pollution%2C_Third_Place.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1920,"thumbheight":2881,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/2/22/Light_pollution%2C_Third_Place.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/22/Light_pollution%2C_Third_Place.jpg/1920px-Light_pollution%2C_Third_Place.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1920,"height":2881,"srcset":"https://upload.wikimedia.org/wikipedia/commons/2/22/Light_pollution%2C_Third_Place.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/2/22/Light_pollution%2C_Third_Place.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Light_pollution,_Third_Place.jpg","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/115179331","extmetadata":{"DateTime":{"value":"2022-02-11 18:38:31","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Light pollution, Third Place","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Venus (planet)|SATCON2|Pleiades (star cluster)|Satellite trails|Starlink satellites seen from Earth|Light pollution in astronomy","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Third place in the 2021 IAU OAE Astrophotography Contest, category Light pollution: Satellite swarm versus night sky beauty, by Torsten Hansen, Germany.\nThis image of Venus and the Pleiades also shows the tracks of the Starlink satellites. These satellites which are located at an altitude of approximately 550 kilometres, are part of an ever-growing constellation of satellites aimed to provide worldwide internet access. The reflective surfaces of the satellites, coupled with the fact that they are orbiting around the Earth, means that astronomical observations which require very long exposures capture \u201ctracks\u201d of the satellites in their images. Astronomical images used for scientific research are not usable because the measurements and data will contain these \u201ctracks\u201d. Because the number of satellites is expected to grow, it is likely that in the near future there will be no place on Earth where these satellites will not be visible crossing the sky. This is a new type of light pollution that seems to be an upcoming problem we will have to deal with, as these satellites might prevent optimal observation of the sky.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2019-12-26","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://iau.org/public/images/detail/ann21047i/\">IAU</a> (via <a rel=\"nofollow\" class=\"external autonumber\" href=\"https://baas.aas.org/pub/4m9vu1rf/release/1?readingCollection=b956c163\">[1]</a>)","source":"commons-desc-page"},"Artist":{"value":"Torsten Hansen/IAU OAE","source":"commons-desc-page"},"Permission":{"value":"CC-BY 4.0","source":"commons-desc-page","hidden":""},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/4.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-4.0","source":"commons-templates","hidden":""}}}]},"115179384":{"pageid":115179384,"ns":6,"title":"File:Light pollution, Third Place.tif","index":2,"imagerepository":"local","imageinfo":[{"size":13871748,"width":2400,"height":3601,"pagecount":1,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0a/Light_pollution%2C_Third_Place.tif/lossy-page1-1920px-Light_pollution%2C_Third_Place.tif.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1920,"thumbheight":2881,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0a/Light_pollution%2C_Third_Place.tif/lossy-page1-1920px-Light_pollution%2C_Third_Place.tif.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1920,"height":2881},"url":"https://upload.wikimedia.org/wikipedia/commons/0/0a/Light_pollution%2C_Third_Place.tif?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Light_pollution,_Third_Place.tif","descriptionshorturl":"https://commons.wikimedia.org/wiki/Special:Redirect/page/115179384","extmetadata":{"DateTime":{"value":"2022-02-11 18:40:35","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Light pollution, Third Place","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Venus (planet)|SATCON2|Pleiades (star cluster)|Satellite trails|Starlink satellites seen from Earth|Light pollution in astronomy","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Third place in the 2021 IAU OAE Astrophotography Contest, category Light pollution: Satellite swarm versus night sky beauty, by Torsten Hansen, Germany.\nThis image of Venus and the Pleiades also shows the tracks of the Starlink satellites. These satellites which are located at an altitude of approximately 550 kilometres, are part of an ever-growing constellation of satellites aimed to provide worldwide internet access. The reflective surfaces of the satellites, coupled with the fact that they are orbiting around the Earth, means that astronomical observations which require very long exposures capture \u201ctracks\u201d of the satellites in their images. Astronomical images used for scientific research are not usable because the measurements and data will contain these \u201ctracks\u201d. Because the number of satellites is expected to grow, it is likely that in the near future there will be no place on Earth where these satellites will not be visible crossing the sky. This is a new type of light pollution that seems to be an upcoming problem we will have to deal with, as these satellites might prevent optimal observation of the sky.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2019-12-26","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://iau.org/public/images/detail/ann21047i/\">IAU</a> (via <a rel=\"nofollow\" class=\"external autonumber\" href=\"https://baas.aas.org/pub/4m9vu1rf/release/1?readingCollection=b956c163\">[1]</a>)","source":"commons-desc-page"},"Artist":{"value":"Torsten Hansen/IAU OAE","source":"commons-desc-page"},"Permission":{"value":"CC-BY 4.0","source":"commons-desc-page","hidden":""},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/li