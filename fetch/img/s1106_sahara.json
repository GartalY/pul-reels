sPrimeBot|2025 satellite pictures from CIRA|Photographs taken on 2025-06-02","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"A multi-day time lapse shows Saharan dust drifting across the Atlantic Ocean","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Taken on\u00a02 June 2025, 23:50:00","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://satlib.cira.colostate.edu/weather_media/saharan-dust-drifts-across-atlantic\">Saharan Dust Drifts Across Atlantic</a>","source":"commons-desc-page"},"Artist":{"value":"GOES imagery: CSU/CIRA &amp; NOAA","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"135405717":{"pageid":135405717,"ns":6,"title":"File:Saharan Dust Storm in the Atlantic Ocean.jpg","index":1,"imagerepository":"local","imageinfo":[{"size":3672963,"width":4410,"height":2792,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d4/Saharan_Dust_Storm_in_the_Atlantic_Ocean.jpg/1280px-Saharan_Dust_Storm_in_the_Atlantic_Ocean.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1200,"thumbheight":760,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d4/Saharan_Dust_Storm_in_the_Atlantic_Ocean.jpg/3840px-Saharan_Dust_Storm_in_the_Atlantic_Ocean.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d4/Saharan_Dust_Storm_in_the_Atlantic_Ocean.jpg/1280px-Saharan_Dust_Storm_in_the_Atlantic_Ocean.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1200,"height":760,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/d/d4/Saharan_Dust_Storm_in_the_Atlantic_Ocean.jpg/3840px-Saharan_Dust_Storm_in_the_Atlantic_Ocean.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/d/d4/Saharan_Dust_Storm_in_the_Atlantic_Ocean.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Saharan_Dust_Storm_in_the_Atlantic_Ocean.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=135405717","extmetadata":{"DateTime":{"value":"2023-08-01 12:13:31","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Saharan Dust Storm in the Atlantic Ocean","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Sentinel-3 images|Attribution Copernicus|Copernicus files uploaded by OptimusPrimeBot|Sahara dust over the Atlantic Ocean|Satellite pictures of 2023 dust storms","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"This image, acquired by one of the Copernicus Sentinel-3 satellites on 14 February 2023, shows a Saharan dust storm with transport from the west coast of Africa over to the Atlantic Ocean. The air quality in the Canary Islands (Spain) has been affected by the high concentration of particulate matter (dust) in the air. This has resulted in a yellow alert issued by the Spanish National Meteorological Agency (AEMET). The dust has also caused reduced visibility and disrupted air traffic. According to the forecast by the Copernicus Atmosphere Monitoring Service, the dust had reached Ireland by the night of 14 February and is expected to reach the Arctic Circle in the coming days.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"15 February 2023 (upload date)","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.copernicus.eu/en/media/image-day-gallery/saharan-dust-storm-atlantic-ocean\">Saharan Dust Storm in the Atlantic Ocean</a>","source":"commons-desc-page"},"Artist":{"value":"European Union, Copernicus Sentinel-3 imagery","source":"commons-desc-page"},"LicenseShortName":{"value":"Attribution","source":"commons-desc-page","hidden":""},"Attribution":{"value":"Contains modified Copernicus Sentinel data 2023","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""}}}]},"135361378":{"pageid":135361378,"ns":6,"title":"File:Saharan Dust over the Atlantic (MODIS).jpg","index":11,"imagerepository":"local","imageinfo":[{"size":3518593,"width":8123,"height":6177,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/Saharan_Dust_over_the_Atlantic_%28MODIS%29.jpg/1280px-Saharan_Dust_over_the_Atlantic_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1200,"thumbheight":913,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/Saharan_Dust_over_the_Atlantic_%28MODIS%29.jpg/3840px-Saharan_Dust_over_the_Atlantic_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/Saharan_Dust_over_the_Atlantic_%28MODIS%29.jpg/1280px-Saharan_Dust_over_the_Atlantic_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1200,"height":913,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/58/Saharan_Dust_over_the_Atlantic_%28MODIS%29.jpg/3840px-Saharan_Dust_over_the_Atlantic_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/5/58/Saharan_Dust_over_the_Atlantic_%28MODIS%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Saharan_Dust_over_the_Atlantic_(MODIS).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=135361378","extmetadata":{"DateTime":{"value":"2023-07-31 20:03:29","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Saharan Dust over the Atlantic (MODIS)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"PD NASA|Photographs taken on 2023-02-23|2023 MODIS images|Files from NASA with known IDs|Satellite pictures of Sahara dust over the Atlantic|Photos of Africa by the Aqua (satellite) MODIS|Satellite pictures of 2023 dust storms|MODIS files uploaded by OptimusPrimeBot","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Since mid-February 2023, massive pulses of dust have poured off the west coast of Africa, coloring the skies with a tan haze.\n<p>The Moderate Resolution Imaging Spectroradiometer (MODIS) on board NASA\u2019s Aqua satellite captured a true-color image of dust stretching more than 2,000 km (1,200 miles) over the coastal countries (Mali, Senegal, Gambia, Guinea-Bissau, Guinea, Sierra Leone) to the open waters of the Atlantic. The dust is so thick in the west that it obscures the blue waters of the Atlantic from view.\n</p><p>According to the Copernicus Atmospheric Monitoring Service (CAMS), the first large-scale Saharan dust transport of 2023 took place in mid-February, with dust concentrations across the Iberian Peninsula rising on February 20. The report, published on February 21, forecast that Saharan dust would reach as far north as Denmark by February 23. Daily MODIS imagery confirms dust not only pulsing northward to Europe during that time, but also reaching across the North Atlantic Ocean, closely approaching the shores of South America.\n</p>\nThe Sahara Desert is by far Earth\u2019s largest source of airborne dust, and the storms can arise at any time of year. It is estimated that winds pick up 100 million tons of dust from the Sahara each year, with a sizable portion blowing out over the North Atlantic Ocean. During winter and spring storms, the dust often ends up fertilizing the nutrient-poor soils of South America\u2019s Amazon rainforest.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Taken on\u00a023 February 2023","source":"commons-desc-page"},"Credit":{"value":"This image or video was catalogued by Goddard Space Flight Center of the United States <a href=\"https://en.wikipedia.org/wiki/NASA\" class=\"extiw\" title=\"w:NASA\">National Aeronautics and Space Administration</a> (NASA)\u00a0under <b>Photo\u00a0ID:</b> <a rel=\"nofollow\" class=\"external text\" href=\"https://images.nasa.gov/search?q=2023-02-26&amp;page=1&amp;media=image,video,audio&amp;yearStart=1920&amp;yearEnd=2026\">2023-02-26</a>.","source":"commons-desc-page"},"Artist":{"value":"MODIS Land Rapid Response Team, NASA GSFC","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"137204314":{"pageid":137204314,"ns":6,"title":"File:Saharan dust plume in the Atlantic Sea (Copernicus).jpg","index":4,"imagerepository":"local","imageinfo":[{"size":7693685,"width":3900,"height":2540,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Saharan_dust_plume_in_the_Atlantic_Sea_%28Copernicus%29.jpg/1280px-Saharan_dust_plume_in_the_Atlantic_Sea_%28Copernicus%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1200,"thumbheight":782,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Saharan_dust_plume_in_the_Atlantic_Sea_%28Copernicus%29.jpg/3840px-Saharan_dust_plume_in_the_Atlantic_Sea_%28Copernicus%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Saharan_dust_plume_in_the_Atlantic_Sea_%28Copernicus%29.jpg/1280px-Saharan_dust_plume_in_the_Atlantic_Sea_%28Copernicus%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1200,"height":782,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Saharan_dust_plume_in_the_Atlantic_Sea_%28Copernicus%29.jpg/3840px-Saharan_dust_plume_in_the_Atlantic_Sea_%28Copernicus%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/2/20/Saharan_dust_plume_in_the_Atlantic_Sea_%28Copernicus%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Saharan_dust_plume_in_the_Atlantic_Sea_(Copernicus).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=137204314","extmetadata":{"DateTime":{"value":"2023-09-08 19:50:22","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Saharan dust plume in the Atlantic Sea (Copernicus)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Sentinel-3 images|2020 satellite pictures|Attribution Copernicus|Photographs taken on 2020-06-05|Copernicus files uploaded by OptimusPrimeBot|Satellite pictures of Sahara dust over the Atlantic","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"This image, acquired by one of the Copernicus Sentinel-3 satellites on 5 June 2020, shows a Saharan dust plume extending about 800 km off the coast of Senegal. The dust plumes in this area are triggered by strong winds that blow across the Sahara Desert. These episodes can cause respiratory and visibility issues, but at the same time, they have a unique ecological value. They in fact support the biodiversity of Atlantic Ocean islands and Amazonian rainforests by transporting nutrients and substrates needed to sustain these ecosystems. Data from Copernicus missions and services can be used to monitor air quality around the world.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Taken on\u00a05 June 2020","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.copernicus.eu/en/media/image-day-gallery/saharan-dust-plume-atlantic-sea\">Saharan dust plume in the Atlantic Sea</a>","source":"commons-desc-page"},"Artist":{"value":"European Union, Copernicus Sentinel-3  imagery","source":"commons-desc-page"},"LicenseShortName":{"value":"Attribution","source":"commons-desc-page","hidden":""},"Attribution":{"value":"Contains modified Copernicus Sentinel data 2020","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""}}}]}}}}