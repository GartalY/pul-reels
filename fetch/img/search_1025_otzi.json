icense":{"value":"cc-by-sa-4.0","source":"commons-templates","hidden":""}}}]},"86278407":{"pageid":86278407,"ns":6,"title":"File:S41598-019-56316-y.pdf","index":12,"imagerepository":"local","imageinfo":[{"size":1177500,"width":1239,"height":1629,"pagecount":6,"url":"https://upload.wikimedia.org/wikipedia/commons/7/74/S41598-019-56316-y.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:S41598-019-56316-y.pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=86278407","extmetadata":{"DateTime":{"value":"2020-01-24 21:18:50","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"S41598-019-56316-y","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Nesyamun|2020-01-23|Images with extracted images|Media from Scientific Reports","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"The sound of a 3,000 year old mummified individual has been accurately reproduced as a vowel-like sound based on measurements of the precise dimensions of his extant vocal tract following Computed Tomography (CT) scanning, enabling the creation of a 3-D printed vocal tract. By using the Vocal Tract Organ, which provides a user-controllable artificial larynx sound source, a vowel sound is synthesised which compares favourably with vowels of modern individuals.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2020-01-23","source":"commons-desc-page"},"Credit":{"value":"<p><a rel=\"nofollow\" class=\"external free\" href=\"https://www.nature.com/articles/s41598-019-56316-y\">https://www.nature.com/articles/s41598-019-56316-y</a>\n</p>\n<a rel=\"nofollow\" class=\"external free\" href=\"https://doi.org/10.1038/s41598-019-56316-y\">https://doi.org/10.1038/s41598-019-56316-y</a>","source":"commons-desc-page