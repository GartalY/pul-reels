ates","hidden":""}}}]},"17177042":{"pageid":17177042,"ns":6,"title":"File:Interface Message Processor Front Panel.jpg","index":3,"imagerepository":"local","imageinfo":[{"size":4338782,"width":3872,"height":2592,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/04/Interface_Message_Processor_Front_Panel.jpg/1920px-Interface_Message_Processor_Front_Panel.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1071,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/04/Interface_Message_Processor_Front_Panel.jpg/3840px-Interface_Message_Processor_Front_Panel.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/04/Interface_Message_Processor_Front_Panel.jpg/1920px-Interface_Message_Processor_Front_Panel.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1071,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/0/04/Interface_Message_Processor_Front_Panel.jpg/3840px-Interface_Message_Processor_Front_Panel.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/0/04/Interface_Message_Processor_Front_Panel.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Interface_Message_Processor_Front_Panel.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=17177042","extmetadata":{"DateTime":{"value":"2011-10-30 11:08:56","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Interface Message Processor Front Panel","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Taken with Nikon D3000|Network routers|Internet history|Interface Message Processor|Self-published work|Campus of the University of California, Los Angeles","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"This is a photo of the front panel of the very first <a href=\"https://en.wikipedia.org/wiki/Interface_Message_Processor\" class=\"extiw\" title=\"w:Interface Message Processor\">Interface Message Processor</a> (IMP).  This one was used at the <a href=\"https://en.wikipedia.org/wiki/University_of_California,_Los_Angeles\" class=\"extiw\" title=\"w:University of California, Los Angeles\">UCLA</a> Boelter 3420 lab to transmit the first message on the Internet.\nI took this photo at the grand opening of the <a rel=\"nofollow\" class=\"external text\" href=\"http://internethistory.ucla.edu\">Kleinrock Internet Heritage Site and Archive</a>, which is a restoration of the original Boelter 3420 lab and equipment as a museum dedicated to preserving the birthplace of the Internet and its history.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2011-10-29","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:FastLizard4\" title=\"User:FastLizard4\">FastLizard4</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 3.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 3.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/3.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-sa-3.0","source":"commons-templates","hidden":""}}}]},"74997504":{"pageid":74997504,"ns":6,"title":"File:Magnetic tapes of the SDS Sigma 7 mainframe computer - UCLA Boelter 3420 laboratory - 2011.jpg","index":4,"imagerepository":"local","imageinfo":[{"size":3506606,"width":3872,"height":2592,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f4/Magnetic_tapes_of_the_SDS_Sigma_7_mainframe_computer_-_UCLA_Boelter_3420_laboratory_-_2011.jpg/1920px-Magnetic_tapes_of_the_SDS_Sigma_7_mainframe_computer_-_UCLA_Boelter_3420_laboratory_-_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":1071,"responsiveUrls":{"2":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f4/Magnetic_tapes_of_the_SDS_Sigma_7_mainframe_computer_-_UCLA_Boelter_3420_laboratory_-_2011.jpg/3840px-Magnetic_tapes_of_the_SDS_Sigma_7_mainframe_computer_-_UCLA_Boelter_3420_laboratory_-_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f4/Magnetic_tapes_of_the_SDS_Sigma_7_mainframe_computer_-_UCLA_Boelter_3420_laboratory_-_2011.jpg/1920px-Magnetic_tapes_of_the_SDS_Sigma_7_mainframe_computer_-_UCLA_Boelter_3420_laboratory_-_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":1071,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/f4/Magnetic_tapes_of_the_SDS_Sigma_7_mainframe_computer_-_UCLA_Boelter_3420_laboratory_-_2011.jpg/3840px-Magnetic_tapes_of_the_SDS_Sigma_7_mainframe_computer_-_UCLA_Boelter_3420_laboratory_-_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/f/f4/Magnetic_tapes_of_the_SDS_Sigma_7_mainframe_computer_-_UCLA_Boelter_3420_laboratory_-_2011.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Magnetic_tapes_of_the_SDS_Sigma_7_mainframe_computer_-_UCLA_Boelter_3420_laboratory_-_2011.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=74997504","extmetadata":{"DateTime":{"value":"2018-12-11 19:16:44","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Magnetic tapes of the SDS Sigma 7 mainframe computer - UCLA Boelter 3420 laboratory - 2011","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"University of California, Los Angeles|SDS Sigma 7|Flickr images verified by UploadWizard|Files with coordinates missing SDC location of creation","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"34.068773","source":"commons-desc-page"},"GPSLongitude":{"value":"-118.442616","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"These are tapes for the SDS Sigma 7 computer used by the UCLA Boelter 3420 lab, the birthplace of the Internet.  The Sigma-7 used the Interface Message Processor to transmit messages (we call them \"packets\" today) to other IMPs and systems connected to the ARPANET.  UCLA's Sigma-7 and IMP form the first node to ever be connected to the ARPANET, which would become the Internet that we all know and love today.\n<p>The very first message ever sent on the Internet was sent from this very room on 29 October 1969 at 22:30 Pacific Time to the Stanford Research Institute, promptly crashing the computer on Stanford's end.\n</p>\nPhoto taken at the grand re-opening of the original Boelter 3420 lab at UCLA, the birthplace of the Internet, as the Kleinrock Internet Heritage Site and Archive, which will soon open to the public.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2011-10-29 14:36:56","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" href=\"https://www.flickr.com/photos/fastlizard4/6293910323/\">https://www.flickr.com/photos/fastlizard4/6293910323/</a>","source":"commons-desc-page"},"Artist":{"value":"Andrew \"FastLizard4\" Adams","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-sa-2.0","source":"commons-templates","hidden":""}}}]},"91595931":{"pageid":91595931,"ns":6,"title":"File:Network management survey (IA networkmanagemen805cott).pdf","index":9,"imagerepository":"local","imageinfo":[{"size":4525857,"width":1037,"height":1458,"pagecount":96,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Network_management_survey_%28IA_networkmanagemen805cott%29.pdf/page1-960px-Network_management_survey_%28IA_networkmanagemen805cott%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":2250,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Network_management_survey_%28IA_networkmanagemen805cott%29.pdf/page1-960px-Network_management_survey_%28IA_networkmanagemen805cott%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":2250},"url":"https://upload.wikimedia.org/wikipedia/commons/2/20/Network_management_survey_%28IA_networkmanagemen805cott%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionur