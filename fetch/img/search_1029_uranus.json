{"batchcomplete":"","continue":{"gsroffset":15,"continue":"gsroffset||"},"query":{"pages":{"11055334":{"pageid":11055334,"ns":6,"title":"File:File-Uranus, Earth size comparison without Earth.png","index":10,"imagerepository":"local","imageinfo":[{"size":324219,"width":796,"height":796,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/a/a6/File-Uranus%2C_Earth_size_comparison_without_Earth.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1600,"thumbheight":1600,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/a/a6/File-Uranus%2C_Earth_size_comparison_without_Earth.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":1600},"url":"https://upload.wikimedia.org/wikipedia/commons/a/a6/File-Uranus%2C_Earth_size_comparison_without_Earth.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:File-Uranus,_Earth_size_comparison_without_Earth.png","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=11055334","extmetadata":{"DateTime":{"value":"2010-07-31 17:53:37","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"File-Uranus, Earth size comparison without Earth","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Uranus (planet)|PD NASA|Photos of Uranus by Voyager 2","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Uranus","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Originele upload op 20 maart 2006, deze op July 31, 2010","source":"commons-desc-page"},"Credit":{"value":"<a href=\"//commons.wikimedia.org/wiki/File:Uranus,_Earth_size_comparison.jpg\" title=\"File:Uranus, Earth size comparison.jpg\">Fil