ts":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"This is an image of the planet Uranus taken by the spacecraft Voyager 2 in 1986. The Voyager project is managed for NASA by the Jet Propulsion Laboratory.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1986-12-18","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" data-mw-original-href=\"http://photojournal.jpl.nasa.gov/catalog/PIA18182\" href=\"https://photojournal.jpl.nasa.gov/catalog/PIA18182\">http://photojournal.jpl.nasa.gov/catalog/PIA18182</a>","source":"commons-desc-page"},"Artist":{"value":"NASA","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"38375006":{"pageid":38375006,"ns":6,"title":"File:Uranus from Voyager 2.jpg","index":3,"imagerepository":"local","imageinfo":[{"size":104651,"width":732,"height":500,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/8/8b/Uranus_from_Voyager_2.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1600,"thumbheight":1093,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/8/8b/Uranus_from_Voyager_2.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":1093},"url":"https://upload.wikimedia.org/wikipedia/commons/8/8b/Uranus_from_Voyager_2.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Uranus_from_Voyager_2.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=38375006","extmetadata":{"DateTime":{"value":"2018-08-06 07:46:14","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Uranus from Voyager 2","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Uranus (planet)|PD NASA|Photos of Uranus by Voyager 2|Files uploaded with For the Common Good","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Uranus imaged by Voyager 2 in 1986","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" data-mw-original-href=\"http://solarsystem.nasa.gov/multimedia/display.cfm?Category=Planets&amp;IM_ID=13583\" href=\"https://solarsystem.nasa.gov/multimedia/display.cfm?Category=Planets&amp;IM_ID=13583\">http://solarsystem.nasa.gov/multimedia/display.cfm?Category=Planets&amp;IM_ID=13583</a>","source":"commons-desc-page"},"Artist":{"value":"NASA","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"39829407":{"pageid":39829407,"ns":6,"title":"File:Uranus from Voyager 2 (1986).jpg","index":5,"imagerepository":"local","imageinfo":[{"size":41743,"width":851,"height":835,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/9/92/Uranus_from_Voyager_2_%281986%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1600,"thumbheight":1570,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/9/92/Uranus_from_Voyager_2_%281986%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":1570},"url":"https://upload.wikimedia.org/wikipedia/commons/9/92/Uranus_from_Voyager_2_%281986%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Uranus_from_Voyager_2_(1986).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=39829407","extmetadata":{"DateTime":{"value":"2015-04-28 07:25:46","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Uranus from Voyager 2 (1986)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"PD NASA|Photos of Uranus by Voyager 2","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"This image of Uranus taken by the Voyager 2 spacecraft in 1986.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1986","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" data-mw-original-href=\"http://nssdc.gsfc.nasa.gov/planetary/image/uranus_voy2.jpg\" href=\"https://nssdc.gsfc.nasa.gov/planetary/image/uranus_voy2.jpg\">http://nssdc.gsfc.nasa.gov/planetary/image/uranus_voy2.jpg</a>","source":"commons-desc-page"},"Artist":{"value":"NASA","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"1303135":{"pageid":1303135,"ns":6,"title":"File:Uranus rings and two moons.jpg","index":12,"imagerepository":"local","imageinfo":[{"size":221428,"width":740,"height":725,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/5/5c/Uranus_rings_and_two_moons.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1600,"thumbheight":1568,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/5/5c/Uranus_rings_and_two_moons.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":1568},"url":"https://upload.wikimedia.org/wikipedia/commons/5/5c/Uranus_rings_and_two_moons.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Uranus_rings_and_two_moons.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=1303135","extmetadata":{"DateTime":{"value":"2006-10-23 13:40:01","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Uranus rings and two moons","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"PD NASA|Uranus (rings)|Cordelia (moon)|Ophelia (moon)|Photos of Uranus' moons by Voyager 2|Photos of Uranus' rings by Voyager 2","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"<p>Original Caption Released with Image:\n</p>\nVoyager 2 has discovered two \"shepherd\" satellites associated with the rings of Uranus. The two moons -- designated 1986U7 and 1986U8 -- are seen here on either side of the bright epsilon ring; all nine of the known Uranian rings are visible. The image was taken Jan. 21, 1986, at a distance of 4.1 million kilometers (2.5 million miles) and resolution of about 36 km (22 mi). The image was processed to enhance narrow features. The epsilon ring appears surrounded by a dark halo as a result of this processing; occasional blips seen on the ring are also artifacts. Lying inward from the epsilon ring are the delta, gamma and eta rings; then the beta and alpha rings; and finally the barely visible 4, 5 and 6 rings. The rings have been studied since their discovery in 1977, through observations of how they diminish the light of stars they pass in front of. This image is the first direct observation of all nine rings in reflected sunlight. They range in width from about 100 km (60 mi) at the widest part of the epsilon ring to only a few kilometers for most of the others. The discovery of the two ring moons 1986U7 and 1986U8 is a major advance in our understanding of the structure of the Uranian rings and is in good agreement with theoretical predictions of how these narrow rings are kept from spreading out. Based on likely surface brightness properties, the moons are of roughly 2O- and 3O-km diameter, respectively. The Voyager project is managed for NASA by the Jet Propulsion Laboratory.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1986","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" href=\"https://science.nasa.gov/uranus/moons/cordelia/\">https://science.nasa.gov/uranus/moons/cordelia/</a>","source":"commons-desc-page"},"Artist":{"value":"NASA","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"15480212":{"pageid":15480212,"ns":6,"title":"File:Voyager 2 Uranus Encounter Trajectory.png","index":11,"imagerepository":"local","imageinfo":[{"size":103292,"width":540,"height":600,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/1/19/Voyager_2_Uranus_Encounter_Trajectory.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1600,"thumbheight":1778,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/1/19/Voyager_2_Uranus_Encounter_Trajectory.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":1778},"url":"https://upload.wikimedia.org/wikipedia/commons/1/19/Voyager_2_Uranus_Encounter_Trajectory.png?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Voyager_2_Uranus_Encounter_Trajectory.png","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=15480212","extmetadata":{"DateTime":{"value":"2011-06-11 20:34:41","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Voyager 2 Uranus Encounter Trajectory","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"PD NASA|Retouched pictures|Trajectory of Voyager 2","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Voyager 2 trajectory in Uranus System, January 24, 1986.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1985-04-10","source":"commons-desc-page"},"Credit":{"value":"Diagram from Voyager Bulletin No. 68; <a rel=\"nofollow\" class=\"external text\" href=\"http://planetary.s3.amazonaws.com/voyager_msb/VoyagerMSB68.PDF\">link</a>","source":"commons-desc-page"},"Artist":{"value":"NASA / JPL","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]}}}}