ps://thumb.wikimedia.org/wikipedia/commons/thumb/a/ac/Launching_the_Spruce_Goose_%286586541641%29_%282%29.jpg/3840px-Launching_the_Spruce_Goose_%286586541641%29_%282%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/a/ac/Launching_the_Spruce_Goose_%286586541641%29_%282%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Launching_the_Spruce_Goose_(6586541641)_(2).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=28076245","extmetadata":{"DateTime":{"value":"2013-09-05 13:22:17","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Launching the Spruce Goose (6586541641) (2)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Taken with Canon EOS 60D|Aviation files (check needed)|Flickr images reviewed by File Upload Bot (Magnus Manske)|Photographs by Clemens Vasters|Files with coordinates missing SDC location of creation|Hughes H-4 Hercules at Evergreen Aviation Museum","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"GPSLatitude":{"value":"45.204220","source":"commons-desc-page"},"GPSLongitude":{"value":"-123.144142","source":"commons-desc-page"},"GPSMapDatum":{"value":"WGS-84","source":"commons-desc-page","hidden":""},"ImageDescription":{"value":"<p>1. Howard Hughes speaks with flight engineer Joe Petrali,\nbeside the forward door of the drydocked seaplane, March\n</p>\n<pre>18, 1947.\n</pre>\n<p>2. This photograph, taken from mid-section, shows the\n</p>\n<pre>interior aft of the fuselage. Workrmen inspect hydraulic\nlines which extend from nose to tail. In the foreground, note \n</pre>\n<p>in\ufb02ated beach balls, secured in netting. Determined to be prepared \nfor any contingency, Hughes ordered the beach balls installed \nprior to the taxi tests to provide added \ufb02otation should the \nhull's bottom sustain damage, November 1, 1947.\n</p><p>3. Hughes speaks with an engineer on the flight deck of the\n</p>\n<pre>Spruce Goose. Protective loft socks cover their shoes. To\nHughes\u2018 right is a ladder leading to the cargo hold below.\n</pre>\n<p>4. Garbed in coat, tie and baggy pants, Hughes inspects one \nof two 110-horsepower auxiliary power units, located aft \non the flight deck, March 18, 1947. The dark, circular crawl hole\n</p>\n<pre>to his right leads to passageways which extend to the wingtips.\n</pre>\n<p>5. Workers take up the slack on a mooring cable as they posi\ntion the aircraft prior to launch, November 1, 1947.\n</p><p>6. Hughes and General Manager Jack Jerman discuss the launch\ning procedure from atop the docking elevator, November 1, 1947\n</p><p>7. Microphone in hand, Hughes directs the final phases of the\nlaunch from his lofty perch on the docking elevator,\nNovember 1, 1947.\n</p><p>8. The Spruce Goose emerges from its docking berth,\nNovember 1, 1947. Due to high winds and choppy seas, Hughe:\n</p>\npostponed the taxi tests until the following day.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2011-12-27 09:30","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/clemensv/6586541641/\">Launching the Spruce Goose</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/7489441@N06\">Clemens Vasters</a> from Viersen, Germany","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}}}]},"104225472":{"pageid":104225472,"ns":6,"title":"File:Memoirs of an Aeronautical Engineer- Flight Tests at Ames Research Center, 1940-1970 - NASA Monographs in Aerospace History, No. 26 (2002).pdf","index":4,"imagerepository":"local","imageinfo":[{"size":18359275,"width":1231,"height":1643,"pagecount":173,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/52/Memoirs_of_an_Aeronautical_Engineer-_Flight_Tests_at_Ames_Research_Center%2C_1940-1970_-_NASA_Monographs_in_Aerospace_History%2C_No._26_%282002%29.pdf/page1-960px-Memoirs_of_an_Aeronautical_Engineer-_Flight_Tests_at_Ames_Research_Center%2C_1940-1970_-_NASA_Monographs_in_Aerospace_History%2C_No._26_%282002%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1920,"thumbheight":2563,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/5/52/Memoirs_of_an_Aeronautical_Engineer-_Flight_Tests_at_Ames_Research_Center%2C_1940-1970_-_NASA_Monographs_in_Aerospace_History%2C_No._26_%282002%29.pdf/page1-960px-Memoirs_of_an_Aeronautical_Engineer-_Flight_Tests_at_Ames_Research_Center%2C_1940-1970_-_NASA_Monographs_in_Aerospace_History%2C_No._26_%282002%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1920,"height":2563},"url":"https://upload.wikimedia.org/wikipedia/commons/5/52/Memoirs_of_an_Aeronautical_Engineer-_Flight_Tests_at_Ames_Research_Center%2C_1940-1970_-_NASA_Monographs_in_Aerospace_History%2C_No._26_%282002%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Memoirs_of_an_Aeronautical_Engineer-_Flight_Tests_at_Ames_Resea