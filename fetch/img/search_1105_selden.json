value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"59027113":{"pageid":59027113,"ns":6,"title":"File:Selden case accumulation of evidence 1906.jpg","index":2,"imagerepository":"local","imageinfo":[{"size":76839,"width":614,"height":517,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/f/f6/Selden_case_accumulation_of_evidence_1906.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1600,"thumbheight":1347,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/f/f6/Selden_case_accumulation_of_evidence_1906.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":1347},"url":"https://upload.wikimedia.org/wikipedia/commons/f/f6/Selden_case_accumulation_of_evidence_1906.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Selden_case_accumulation_of_evidence_1906.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=59027113","extmetadata":{"DateTime":{"value":"2017-05-18 09:43:26","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Selden case accumulation of evidence 1906","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"1906 in New York City|1906 in the United States|George Baldwin Selden|PD US expired|1906 in road transport|Template Unknown (author)|Newspapers of the United States, 1906|PD-US missing SDC copyright status|Association of Licensed Automobile Manufacturers|Selden road engine","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Selden Road engine replica during accumulation of evidence in the Selden patent litigation against Henry Ford, May, 19th, 1906, in and in front of the Decauville Automobile Company, at Broadway and 56th street, New York. \n<p>Patent attorney and inventor George Baldwin Selden (1846-1922) claimed to have invented \"the automobile\" in 1877, applied for a patent in 1879, and was granted one finally in November, 1895. It was the legal base on the several Selden patent suits following.\n</p>\nThis picture appeared within a report on this event and the case in the <i>Automobile Magazine</i>, May, 24th, 1906. Capture reads: \"THE SELDEN CAR AS IT APPEARED AT THE DEMONSTRATION GIVEN TO THE PATENT EXPERTS - George B. Selden, the inventor, Is the man with the gray moustache standing partly to the rear of the body of the car. He can be distinguished by the watch chain on his vest. Henry R. Selden is at the wheel, and W. A. Redding and H. F. Cun[t]z are at the right of the picture. The Hon. George Raines is behind the steering wheel, only his straw hat showing.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1906-05-14","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" href=\"http://www.earlyamericanautomobiles.com/americanautomobiles7d.htm\">http://www.earlyamericanautomobiles.com/americanautomobiles7d.htm</a>","source":"commons-desc-page"},"Artist":{"value":"Unknown author<span style=\"display: none;\">Unknown author</span>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"96581833":{"pageid":96581833,"ns":6,"title":"File:Story of