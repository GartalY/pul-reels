0).jpg","index":11,"imagerepository":"local","imageinfo":[{"size":6704730,"width":2263,"height":3000,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/Saturn_Apollo_Program_%286757950%29.jpg/1280px-Saturn_Apollo_Program_%286757950%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1280,"thumbheight":1697,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/8/8a/Saturn_Apollo_Program_%286757950%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8a/Saturn_Apollo_Program_%286757950%29.jpg/1280px-Saturn_Apollo_Program_%286757950%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1280,"height":1697,"srcset":"https://upload.wikimedia.org/wikipedia/commons/8/8a/Saturn_Apollo_Program_%286757950%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/8/8a/Saturn_Apollo_Program_%286757950%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Saturn_Apollo_Program_(6757950).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=150566676","extmetadata":{"DateTime":{"value":"2024-07-20 18:30:19","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Saturn Apollo Program (6757950)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"PD NASA|Apollo 4|Photographs taken on 1967-11-01|Files from NASA with known IDs|NASA Library files uploaded by OptimusPrimeBot","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"This is a view of the the first test flight of the Saturn V vehicle (SA-501) at the Kennedy Space Center (KSC) launch complex 39A, awaiting the scheduled launch on November 9, 1967. Designated as Apollo 4, this mission was the first launch of the Saturn V launch vehicle. Objectives of the unmanned Apollo 4 test flight were to obtain flight information on launch vehicle and spacecraft structural integrity and compatibility, flight loads, stage separation, and subsystems operation including testing of restart of the S-IVB stage, and to evaluate the Apollo command module heat shield.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"Taken on\u00a01 November 1967","source":"commons-desc-page"},"Credit":{"value":"This image or video was catalogued by George C. Marshall Space Flight Center of the United States <a href=\"https://en.wikipedia.org/wiki/NASA\" class=\"extiw\" title=\"w:NASA\">National Aeronautics and Space Administration</a> (NASA)\u00a0under <b>Photo\u00a0ID:</b> <a rel=\"nofollow\" class=\"external text\" href=\"https://images.nasa.gov/search?q=6757950&amp;page=1&amp;media=image,video,audio&amp;yearStart=1920&amp;yearEnd=2026\">6757950</a>.","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.nasa.gov/marshall/\">NASA Marshall Space Flight Center</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"150566673":{"pageid":150566673,"ns":6,"title":"File:Saturn Apollo Program (6760629).jpg","index":7,"imagerepository":"local","imageinfo":[{"size":176609,"width":884,"height":1140,"thum