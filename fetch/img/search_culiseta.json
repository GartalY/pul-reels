aign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":674,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/4/46/Pistes%C3%A4%C3%A4sklase_Culiceta_annulata_tiib.jpg/3840px-Pistes%C3%A4%C3%A4sklase_Culiceta_annulata_tiib.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/4/46/Pistes%C3%A4%C3%A4sklase_Culiceta_annulata_tiib.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Pistes%C3%A4%C3%A4sklase_Culiceta_annulata_tiib.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=141764826","extmetadata":{"DateTime":{"value":"2023-12-05 10:48:20","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Pistes\u00e4\u00e4sklase Culiceta annulata tiib","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Culiseta annulata|CC-Zero|Thin-film interference|Self-published work|Images from Wiki Science Competition 2023 in Estonia|Microscopy images from Wiki Science Competition 2023|Featured photographs in the public domain|National finalists for the Microscopy category from Wiki Science Competition 2023|Culicidae wings|Uploaded via Campaign:wsc-ee|Featured pictures from Wiki Science Competition 2023","source":"commons-categories","hidden":""},"Assessments":{"value":"featured","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Recently, it was discovered that various insects with seemingly transparent wings, display vivid structural coloration against dark backgrounds. Wavelength of the reflected light is dependent on the thickness of the chitinous membrane of the wing, microstructures (see at high magnification), hair and scale placement, and venation. In some insects (Drosophila sp.), WIPs may function as species- and sex-specific visual mating cues in a range of taxa. The role of species-specific WIPs in Culicidae mosquitoes is unknown.\n<p>About 70 small, partial focus stacked images across the mosquito wing were photomicrographed at 50X magnification with the Microscope Nikon Eclipse FN1 and digital camera Nikon DS-Ri2. These small image stacks were merged together using the image processing software Photoshop. \n</p>\nImage was taken on November 18, 2021. The image is a crop of the very large original image with the resolution of 41632 x 17530 pixels.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2021-11-18","source":"commons-desc-page"},"Credit":{"value":"<span class=\"int-own-work\" lang=\"en\">Own work</span>","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Enno_Merivee\" title=\"User:Enno Merivee\">Enno Merivee</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Zero, Public Domain Dedication","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"http://creativecommons.org/publicdomain/zero/1.0/deed.en","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc0","source":"commons-templates","hidden":""}}}]}}}}