ion","hidden":""},"Categories":{"value":"PD NASA|Spacecraft design|Renderings of spacecraft|Art from NASA|Illustrations of Voyager spacecraft","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Artist's rendering, from <a href=\"https://en.wikipedia.org/wiki/NASA\" class=\"extiw\" title=\"w:NASA\">NASA</a>, of the design employed by the twin <i><a href=\"https://en.wikipedia.org/wiki/Voyager_1\" class=\"extiw\" title=\"w:Voyager 1\">Voyager 1</a></i> and <i><a href=\"https://en.wikipedia.org/wiki/Voyager_2\" class=\"extiw\" title=\"w:Voyager 2\">Voyager 2</a></i> spacecraft, in mission configuration. Sent into the outer solar system for the purpose of embarking on the \"grand tour\" of the <a href=\"https://en.wikipedia.org/wiki/Gas_giant\" class=\"extiw\" title=\"w:Gas giant\">Gas giants</a>, <i>Voyager 1</i> made successful reconnaissance flybys of the planet <a href=\"https://en.wikipedia.org/wiki/Jupiter\" class=\"extiw\" title=\"w:Jupiter\">Jupiter</a> and <a href=\"https://en.wikipedia.org/wiki/Saturn\" class=\"extiw\" title=\"w:Saturn\">Saturn</a> in 1979 and 1980. <i>Voyager 2</i> also performed flybys of Jupiter and Saturn in 1979 and 1981, along with the very first, and so far only, visits of the planets <a href=\"https://en.wikipedia.org/wiki/Uranus\" class=\"extiw\" title=\"w:Uranus\">Uranus</a> and <a href=\"https://en.wikipedia.org/wiki/Neptune\" class=\"extiw\" title=\"w:Neptune\">Neptune</a> in 1986 and 1989.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"circa 2016<div style=\"display: none;\">date QS:P,+2016-00-00T00:00:00Z/9,P1480,Q5727902</div>","source":"commons-desc-page"},"Credit":{"value":"<b>Published source</b>: \"<a rel=\"nofollow\" class=\"external autonumber\" href=\"https://science.nasa.gov/multimedia/spacecraft-icons/\">[1]</a>\" at NASA Science<br><b>Direct source</b>: <a rel=\"nofollow\" class=\"external text\" href=\"https://smd-prod.s3.amazonaws.com/science-green/s3fs-public/thumbnails/image/Voyager.png\">Image</a> hosted by smd-prod.s3.amazonaws.com.","source":"commons-desc-page"},"Artist":{"value":"<a href=\"https://en.wikipedia.org/wiki/NASA\" class=\"extiw\" title=\"w:NASA\">National Aeronautics and Space Administration (NASA)</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"26133490":{"pageid":26133490,"ns":6,"title":"File:Voyager the Grand Tour.ogv","index":4,"imagerepository":"local","imageinfo":[{"size":44637703,"width":320,"height":240,"duration":902.2680333333334,"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/fa/Voyager_the_Grand_Tour.ogv/250px--Voyager_the_Grand_Tour.ogv.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo","thumbwidth":320,"thumbheight":240,"thumbattribs":[],"url":"https://upload.wikimedia.org/wikipedia/commons/f/fa/Voyager_the_Grand_Tour.ogv?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Voyager_the_Grand_Tour.ogv","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=26133490","extmetadata":{"DateTime":{"value":"2013-05-17 11:24:23","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Voyager the Grand Tour","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"PD NASA|Voyager 2|Voyager 1|Video display resolution 320 x 240|NASA videos in 2013|Trajectory of Voyager 1|Trajectory of Voyager 2|Videos by NASA|Animations of tr