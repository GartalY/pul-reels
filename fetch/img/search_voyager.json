{"batchcomplete":"","continue":{"gsroffset":12,"continue":"gsroffset||"},"query":{"pages":{"7998353":{"pageid":7998353,"ns":6,"title":"File:Pandora - Voyager 2.jpg","index":12,"imagerepository":"local","imageinfo":[{"size":2487,"width":120,"height":120,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/7/7a/Pandora_-_Voyager_2.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1600,"thumbheight":1600,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/7/7a/Pandora_-_Voyager_2.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":1600},"url":"https://upload.wikimedia.org/wikipedia/commons/7/7a/Pandora_-_Voyager_2.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Pandora_-_Voyager_2.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=7998353","extmetadata":{"DateTime":{"value":"2019-07-21 22:39:42","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Pandora - Voyager 2","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Pandora (moon)|PD NASA|Photos of Saturn system by Voyager 2","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"<i>Original caption:</i> Detail of Voyager 2 image showing Saturn's moon Pandora, taken 6 hours before Voyager's closest approach to Saturn. Pandora is irregularly shaped, 110 x 90 x 60 km, and bright, with visible albedo of 0.9. The satellite orbits with a semi-major axis of 142,000 km and acts as the outer shepherding satellite (Prometheus is the inner) of Saturn's F-ring. North is approximately up and Pandora is about 70 km across in the image. (Voyager 2, FDS 43998.15)","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1981-08-25 21:30:21","source":"commons-desc-page"},"Credit":{"value":"<p>Voyager 2, FDS 43998.15\n</p>\n<ul><li><a rel=\"nofollow\" class=\"external free\" data-mw-original-href=\"http://nssdc.gsfc.nasa.gov/imgcat/html/object_page/vg2_4399815.html\" href=\"https://nssdc.gsfc.nasa.gov/imgcat/html/object_page/vg2_4399815.html\">http://nssdc.gsfc.nasa.gov/imgcat/html/object_page/vg2_4399815.html</a></li>\n<li><a rel=\"nofollow\" class=\"external free\" href=\"http://solarviews.com/cap/sat/pandora.htm\">http://solarviews.com/cap/sat/pandora.htm</a> (<a rel=\"nofollow\" class=\"external text\" href=\"http://solarviews.com/raw/sat/pandora.gif\">image link</a>)</li></ul>","source":"commons-desc-page"},"Artist":{"value":"NASA","source":"commons-desc-page"},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"167703":{"pageid":167703,"ns":6,"title":"File:Voyager.jpg","index":3,"imagerepository":"local","imageinfo":[{"size":154236,"width":800,"height":626,"thumburl":"https://upload.wikimedia.org/wikipedia/commons/d/d2/Voyager.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","thumbwidth":1600,"thumbheight":1252,"thumbattribs":{"src":"https://upload.wikimedia.org/wikipedia/commons/d/d2/Voyager.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled","decoding":"async","loading":"lazy","width":1600,"height":1252},"url":"https://upload.wikimedia.org/wikipedia/commons/d/d2/Voyager.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Voyager.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=167703","extmetadata":{"DateTime":{"value":"2009-01-18 09:52:27","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Voyager","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Voyager spacecraft|PD NASA|Images with annotations|Images with 10+ annotations|Objects with black background","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"NASA photograph of one of the two identical Voyager space probes <a href=\"//commons.wikimedia.org/wiki/Voyager_1\" title=\"Voyager 1\">Voyager 1</a> and <a href=\"//commons.wikimedia.org/wiki/Voyager_2\" title=\"Voyager 2\">Voyager 2</a> launched in 1977.\n<p>The 3.7 metre diameter high-gain antenna (HGA) is attached to the hollow ten-sided polygonal body housing the electronics, here seen in profile. The <a href=\"//commons.wikimedia.org/wiki/Category:Voyager_Golden_Record\" title=\"Category:Voyager Golden Record\">Voyager Golden Record</a> is attached to one of the bus sides.\n</p><p>The angled square panel below is the optical calibration target and excess heat radiator.\n</p><p>The three <a href=\"//commons.wikimedia.org/wiki/Category:Radioisotope_thermoelectric_generators\" title=\"Category:Radioisotope thermoelectric generators\">radioisotope thermoelectric generators</a> (RTGs) are mounted end-to-end on the left-extending boom. One of the two planetary radio and plasma wave antenna extends diagonally left and down, the other extends to the rear, mostly hidden here. The compact structure between the RTGs and the HGA are the high-field and low-field magnetometers (MAG) in their stowed state; after launch an Astromast boom extended to 13 metres to distance the low-field magnetometers.\n</p><p>The instrument boom extending to the right holds, from left to right: the cosmic ray subsystem (CRS) above and Low-Energy Charged Particle (LECP) detector below; the Plasma Spectrometer (PLS) above; and the scan platform that rotates about a vertical axis.\n</p><p>The scan platform comprises: the Infrared Interferometer Spectrometer (IRIS) (largest camera at right); the Ultraviolet Spectrometer (UVS) to the right of the UVS; the two Imaging Science Subsystem (ISS) vidicon cameras to the left of the UVS; and the Photopolarimeter System (PPS) barely visible under the ISS.\n</p>\nSuggested for English <a href=\"https://en.wikipedia.org/wiki/Wikipedia:alternative_text_for_images\" class=\"extiw\" title=\"en:Wikipedia:alternative text for images\">Wikipedia:alternative text for images</a>: A space probe with squat cylindrical body topped by a large parabolic radio antenna dish pointing upwards, a three-element radioisotope thermoelectric generator on a boom extending left, and scientific instruments on a boom extending right. A golden disk is fixed to the body.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1977","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://voyager.jpl.nasa.gov/mission/science/\">NASA Voyager website</a>","source":"commons-desc-page"},"Artist":{"value":"NASA/JPL-Caltech","source":"commons-desc-page"},"Permission":{"value":"PD-NASA","source":"commons-desc-page","hidden":""},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},"61946486":{"pageid":61946486,"ns":6,"title":"File:Voyager 2 Encapsulation PIA21728.jpg","in