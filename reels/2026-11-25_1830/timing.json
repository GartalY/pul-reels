{"dur": 25.2, "chunks": [{"t0": 0.0, "text": "Üç il, üç Avropa qızılı!", "keys": ["Üç", "üç", "qızılı!"], "t1": 2.66}, {"t0": 2.66, "text": "On doqquz yaşlı boksçumuz", "keys": ["On", "doqquz"], "t1": 4.17}, {"t0": 4.17, "text": "Bilalhəbaşi Nəzərov yenə birincidir.", "keys": ["Bilalhəbaşi", "Nəzərov"], "t1": 6.94}, {"t0": 6.94, "text": "Xorvatiyanın Poreç şəhərində,", "keys": ["Poreç"], "t1": 8.848}, {"t0": 8.848, "text": "23 yaşadək boksçular arasında qalib gəldi.", "keys": ["23", "yaşadək"], "t1": 11.9}, {"t0": 11.9, "text": "Finalda 5 hakimin hamısı onu seçdi.", "keys": ["5", "hamısı"], "t1": 14.68}, {"t0": 14.68, "text": "Ən maraqlısı:", "keys": ["maraqlısı:"], "t1": 16.04}, {"t0": 16.04, "text": "ilk Avropa qızılını 2 il əvvəl", "keys": ["ilk", "qızılını"], "t1": 18.192}, {"t0": 18.192, "text": "elə bu şəhərdə qazanmışdı.", "keys": ["bu", "şəhərdə"], "t1": 20.23}, {"t0": 20.23, "text": "Bəyən və izlə —", "keys": ["Bəyən", "izlə"], "t1": 21.69}, {"t0": 21.69, "text": "hər gün bilmədiyin bir fakt!", "keys": ["fakt!"], "t1": 25.2}], "words": [["Üç", -0.05], ["il,", 0.211], ["üç", 0.733], ["Avropa", 0.993], ["qızılı!", 1.602], ["On", 2.7], ["doqquz", 2.809], ["yaşlı", 3.157], ["boksçumuz", 3.591], ["Bilalhəbaşi", 4.2], ["Nəzərov", 4.939], ["yenə", 5.591], ["birincidir.", 5.852], ["Xorvatiyanın", 6.98], ["Poreç", 7.704], ["şəhərində,", 8.096], ["iyirmi", 8.878], ["üç", 9.153], ["yaşadək", 9.313], ["boksçular", 9.748], ["arasında", 10.313], ["qalib", 10.835], ["gəldi.", 11.27], ["Finalda", 11.94], ["beş", 12.53], ["hakimin", 12.748], ["hamısı", 13.27], ["onu", 13.791], ["seçdi.", 14.052], ["Ən", 14.72], ["maraqlısı:", 14.878], ["ilk", 16.08], ["Avropa", 16.352], ["qızılını", 16.743], ["iki", 17.396], ["il", 17.657], ["əvvəl", 17.83], ["elə", 18.222], ["bu", 18.483], ["şəhərdə", 18.613], ["qazanmışdı.", 19.004], ["Bəyən", 20.27], ["və", 20.813], ["izlə", 20.987], ["—", 21.683], ["hər", 21.73], ["gün", 22.03], ["bilmədiyin", 22.349], ["bir", 22.9], ["fakt!", 23.074]]}