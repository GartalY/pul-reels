{"dur": 27.0, "chunks": [{"t0": 0.0, "text": "Xəzərin suyu krana gələcək.", "keys": ["Xəzərin", "krana"], "t1": 2.201}, {"t0": 2.201, "text": "Azərbaycanda ilk böyük", "keys": ["ilk", "böyük"], "t1": 3.853}, {"t0": 3.853, "text": "duzsuzlaşdırma zavodu tikiləcək.", "keys": ["duzsuzlaşdırma"], "t1": 6.07}, {"t0": 6.07, "text": "Gündə nə qədər su verəcək?", "keys": ["nə", "qədər"], "t1": 8.157}, {"t0": 8.157, "text": "Sənin cavabın?", "keys": ["cavabın?"], "t1": 9.505}, {"t0": 9.505, "text": "Üç, iki, bir…", "keys": ["Üç,", "iki,", "bir…"], "t1": 12.157}, {"t0": 12.157, "text": "Gündə 300 000 kubmetr!", "keys": ["300 000"], "t1": 14.418}, {"t0": 14.418, "text": "Təxminən 120 Olimpiya hovuzu.", "keys": ["120"], "t1": 17.114}, {"t0": 17.114, "text": "Xəzər okeandan təxminən", "keys": ["Xəzər"], "t1": 18.983}, {"t0": 18.983, "text": "3 dəfə az duzludur.", "keys": ["3", "az"], "t1": 20.665}, {"t0": 20.665, "text": "Amma yenə də içmək olmur.", "keys": ["olmur."], "t1": 22.491}, {"t0": 22.491, "text": "Bəyən və izlə —", "keys": ["Bəyən", "izlə"], "t1": 23.911}, {"t0": 23.911, "text": "hər gün bilmədiyin bir fakt!", "keys": ["fakt!"], "t1": 27.0}], "words": [["Xəzərin", 0.0], ["suyu", 0.609], ["krana", 0.957], ["gələcək.", 1.348], ["Azərbaycanda", 2.261], ["ilk", 3.304], ["böyük", 3.565], ["duzsuzlaşdırma", 3.913], ["zavodu", 4.783], ["tikiləcək.", 5.188], ["Gündə", 6.13], ["nə", 6.696], ["qədər", 6.87], ["su", 7.13], ["verəcək?", 7.304], ["Sənin", 8.217], ["cavabın?", 8.565], ["Üç,", 9.565], ["iki,", 10.435], ["bir…", 11.565], ["Gündə", 12.217], ["üç", 12.87], ["yüz", 13.13], ["min", 13.304], ["kubmetr!", 13.565], ["Təxminən", 14.478], ["yüz", 15.174], ["iyirmi", 15.522], ["Olimpiya", 15.913], ["hovuzu.", 16.391], ["Xəzər", 17.174], ["okeandan", 17.652], ["təxminən", 18.304], ["üç", 19.043], ["dəfə", 19.261], ["az", 19.652], ["duzludur.", 19.826], ["Amma", 20.725], ["yenə", 21.043], ["də", 21.334], ["içmək", 21.435], ["olmur.", 21.87], ["Bəyən", 22.551], ["və", 23.043], ["i